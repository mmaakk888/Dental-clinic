rules_version = '2';
// STAGED ONLY: not the live membership diagnostic, and not a complete clinic ruleset.
// Owner-only contacts. No client can create memberships or open other domains.
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedOwner(uid) {
      return request.auth != null && request.auth.uid is string
        && request.auth.uid.size() > 0 && request.auth.uid.size() <= 128
        && request.auth.uid == uid && request.auth.token is map
        && request.auth.token.email_verified == true
        && request.auth.token.firebase is map
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.dentalClinicId == 'main'
        && request.auth.token.dentalClinicRole == 'owner'
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time >= 0
        && request.auth.token.auth_time <= 9007199254740991;
    }
    function activeOwner(data, uid) {
      let fields = ['schemaVersion', 'clinicId', 'uid', 'role', 'status', 'identityVersion', 'verifiedAfter'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.clinicId == 'main' && data.uid == uid
        && data.role == 'owner' && data.status == 'active'
        && data.identityVersion is int && data.identityVersion >= 1
        && data.identityVersion <= 9007199254740991
        && data.verifiedAfter is int && data.verifiedAfter >= 0
        && data.verifiedAfter <= 9007199254740991
        && request.auth.token.auth_time >= data.verifiedAfter;
    }
    function owner() {
      return database == '(default)' && verifiedOwner(request.auth.uid)
        && activeOwner(get(/databases/$(database)/documents/clinics/main/members/$(request.auth.uid)).data, request.auth.uid);
    }
    function uuid(id) {
      return id is string && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
    }
    function hash(value) { return value is string && value.matches('[0-9a-f]{64}'); }
    function recordPath(id) { return /databases/$(database)/documents/clinics/main/contactRecords/$(id); }
    function operationPath(id) { return /databases/$(database)/documents/clinics/main/contactOperations/$(id); }
    function phonePath(key) { return /databases/$(database)/documents/clinics/main/contactPhones/$(key); }
    function asciiDigits(value) {
      return value.matches('[^٠-٩۰-۹]*') ? value : value.replace('[٠۰]', '0').replace('[١۱]', '1').replace('[٢۲]', '2')
        .replace('[٣۳]', '3').replace('[٤۴]', '4').replace('[٥۵]', '5')
        .replace('[٦۶]', '6').replace('[٧۷]', '7').replace('[٨۸]', '8').replace('[٩۹]', '9');
    }
    function trimSpaces(value) {
      // Match ECMAScript trim, including pasted NBSP/BOM which Rules trim()
      // does not remove. Controls still fail the separate original-value guard.
      let spaces = '[\\x09-\\x0d\\x20\\x{00a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}\\x{2029}\\x{202f}\\x{205f}\\x{3000}\\x{feff}]';
      return value.replace('^' + spaces + '+|' + spaces + '+$', '');
    }
    function preparedPhone(value) {
      let formatted = trimSpaces(asciiDigits(value));
      let digits = formatted.replace('[^0-9]', '');
      let international = digits.matches('00.*') ? digits[2:digits.size()] : digits;
      let canonical = international.matches('01.*') ? '20' + international[1:international.size()] : international;
      let valid = value.size() <= 60 && value.matches('[^\\x00-\\x1f\\x7f]*')
        && formatted.matches('[+]?[0-9 ().-]+')
        && (!digits.matches('01.*') || digits.matches('01[0-9]{9}'))
        && canonical.matches('[1-9][0-9]{7,14}')
        && (!canonical.matches('20.*') || canonical.matches('201[0-9]{9}'));
      return { 'valid': valid, 'key': hashing.sha256('contact-phone-v1:' + canonical).toHexString().lower() };
    }
    function calendarDay(value) {
      let year = int(value[0:4]);
      let month = int(value[5:7]);
      let day = int(value[8:10]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      let maximum = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
      return day <= maximum;
    }
    function validContact(data, id, phone) {
      return data is map && data.keys().hasAll(['id', 'name', 'mobile', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'mobile', 'createdAt', 'notes'])
        && data.id == id && data.name is string && trimSpaces(data.name).size() > 0
        && data.name.size() <= 200 && data.name.matches('[^\\x00-\\x1f\\x7f]*')
        && data.mobile is string && phone.valid
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000
          && data.notes.matches('[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*')))
        && data.createdAt is string
        && data.createdAt.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,3})?Z')
        && calendarDay(data.createdAt);
    }
    function validRecord(data, id, phone) {
      let fields = ['schemaVersion', 'clinicId', 'recordId', 'revision', 'deleted', 'lastOperationId', 'phoneKey', 'data'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && uuid(id) && data.recordId == id && uuid(data.lastOperationId)
        && data.revision is int && data.revision >= 1 && data.revision <= 2000000000
        && data.deleted is bool
        && (data.deleted ? data.data == null && data.phoneKey == null
          : data.phoneKey == phone.key && validContact(data.data, id, phone));
    }
    function validReceipt(data, id) {
      // requestHash is the client's stable JSON retry fingerprint, NOT a server
      // recomputed content signature. Explicit actor/record/action/revision links
      // are enforced below, and the receipt is create-only. Owner access only.
      let fields = ['schemaVersion', 'clinicId', 'operationId', 'actorUid', 'recordId', 'action', 'expectedRevision', 'resultRevision', 'requestHash'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && uuid(id) && data.operationId == id && uuid(data.recordId)
        && data.actorUid == request.auth.uid
        && data.action in ['create', 'update', 'delete']
        && data.expectedRevision is int && data.expectedRevision >= 0 && data.expectedRevision < 2000000000
        && data.resultRevision is int && data.resultRevision == data.expectedRevision + 1
        && ((data.action == 'create') == (data.expectedRevision == 0)) && hash(data.requestHash);
    }
    function indexMatches(data, key, id) {
      let fields = ['schemaVersion', 'clinicId', 'phoneKey', 'recordId'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && hash(key) && data.phoneKey == key && uuid(id) && data.recordId == id;
    }
    function recordTransition(before, after, id, phone) {
      return validRecord(after, id, phone)
        && (before == null ? after.revision == 1 && !after.deleted
          : !before.data.deleted && before.data.recordId == id
            && after.revision == before.data.revision + 1
            && after.lastOperationId != before.data.lastOperationId
            && (after.deleted || after.data.createdAt == before.data.data.createdAt));
    }
    function recordReceipt(before, after) {
      let op = getAfter(operationPath(after.lastOperationId));
      return !exists(operationPath(after.lastOperationId)) && op != null
        // A receipt absent before and present after MUST be created in this
        // batch. Its own create rule validates schema; don't repeat it here.
        && op.data.recordId == after.recordId;
    }
    function recordPhones(before, after, oldKey, nextKey) {
      return (before == null || get(phonePath(oldKey)).data.recordId == after.recordId)
        && (oldKey == '' || oldKey == nextKey || !existsAfter(phonePath(oldKey)))
        && (nextKey == '' || getAfter(phonePath(nextKey)).data.recordId == after.recordId);
    }
    function contactWrite(before, after, id) {
      let oldKey = before == null ? '' : before.data.phoneKey;
      let phone = after.deleted ? { 'valid': true, 'key': '' } : preparedPhone(after.data.mobile);
      return recordTransition(before, after, id, phone) && recordReceipt(before, after)
        && recordPhones(before, after, oldKey, phone.key);
    }
    function companionChanged(before, after) {
      // Full schema/phone checks belong to the record's own write rule. An
      // unchanged getAfter record cannot authorize a standalone companion write.
      return after != null && (before == null ? after.data.revision == 1
        : !before.data.deleted && after.data.revision == before.data.revision + 1
          && after.data.lastOperationId != before.data.lastOperationId);
    }
    function receiptTransition(data) {
      let before = get(recordPath(data.recordId));
      let after = getAfter(recordPath(data.recordId));
      return companionChanged(before, after)
        && after.data.lastOperationId == data.operationId && after.data.revision == data.resultRevision
        && data.expectedRevision == (before == null ? 0 : before.data.revision)
        && data.action == (before == null ? 'create' : (after.data.deleted ? 'delete' : 'update'));
    }
    function indexTransition(data, key, removing) {
      let before = get(recordPath(data.recordId));
      let after = getAfter(recordPath(data.recordId));
      return companionChanged(before, after)
        && (removing ? before != null && before.data.phoneKey == key
            && (after.data.deleted || after.data.phoneKey != key)
          : !after.data.deleted && after.data.phoneKey == key);
    }
    match /clinics/main/members/{uid} {
      allow get: if database == '(default)' && verifiedOwner(uid) && activeOwner(resource.data, uid);
      allow list, create, update, delete: if false;
    }
    match /clinics/main/contactRecords/{id} {
      allow get: if owner() && uuid(id);
      allow create, update: if owner() && contactWrite(resource, request.resource.data, id);
      allow list, delete: if false;
    }
    match /clinics/main/contactOperations/{id} {
      allow get: if owner() && uuid(id);
      allow create: if owner() && validReceipt(request.resource.data, id) && receiptTransition(request.resource.data);
      allow list, update, delete: if false;
    }
    match /clinics/main/contactPhones/{key} {
      allow get: if owner() && hash(key);
      allow create: if owner() && indexMatches(request.resource.data, key, request.resource.data.recordId)
        && indexTransition(request.resource.data, key, false);
      allow update: if owner() && request.resource.data == resource.data
        && indexMatches(resource.data, key, resource.data.recordId) && indexTransition(resource.data, key, false);
      allow delete: if owner() && indexMatches(resource.data, key, resource.data.recordId)
        && indexTransition(resource.data, key, true);
      allow list: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
