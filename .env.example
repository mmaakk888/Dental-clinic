# Server-only settings. Never use a VITE_ prefix for API/service-account secrets.
# AI is deliberately OFF until an administrator configures real Firebase Auth.
# Local demo passwords/roles are not server authentication and cannot enable AI.
AI_AUTH_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Future setup: create trusted Firebase Auth accounts and integrate a client ID
# token provider. Send Authorization: Bearer <Firebase Auth ID token> per request.
# Verification checks token signature, project, expiry, revoked and disabled users.
AI_FIREBASE_PROJECT_ID=
# Explicit allowed Firebase Auth UIDs, comma-separated. No wildcard/all-users mode.
AI_ALLOWED_UIDS=
# Exact HTTPS browser origins, comma-separated; HTTP is allowed only on loopback.
# For local authorized integration: http://127.0.0.1:3000,http://127.0.0.1:4173
AI_ALLOWED_ORIGINS=
# A server-only service-account file OUTSIDE the repository; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
# On a trusted managed server with workload credentials, explicitly opt in instead.
AI_USE_APPLICATION_DEFAULT_CREDENTIALS=false

# Deployment is a separate step, not automatically performed by build/start.
# npm/pnpm start explicitly uses production and serves only dist, not server code.
PORT=3000
HOST=127.0.0.1

# Per process: 30 incoming requests/IP/minute; 6 AI calls/UID/minute;
# 30 AI calls/UID/hour; 100 calls/server/hour; at most 2 concurrent provider calls
# and 1 call/UID. Images <= 2 MiB; JSON <= 256 KiB (3 MiB for image requests).
# A shared authenticated gateway/quota store is required before multi-instance use.
# Do NOT enable FIREBASE_AUTH_EMULATOR_HOST on a public/production server.
