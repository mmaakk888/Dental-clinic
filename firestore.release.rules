rules_version = '2';
// UNDEPLOYED combined candidate. Only engine-proven domains may be activated.
// Unfinished domain writes remain denied, never broad owner-only upserts.
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedOwner(uid) {
      return request.auth != null && request.auth.uid is string
        && request.auth.uid.size() > 0 && request.auth.uid.size() <= 128
        && request.auth.uid == uid && request.auth.token is map
        && request.auth.token.email_verified == true
        && request.auth.token.firebase is map
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.dentalClinicId == 'main'
        && request.auth.token.dentalClinicRole == 'owner'
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time >= 0
        && request.auth.token.auth_time <= 9007199254740991;
    }
    function activeOwner(data, uid) {
      let fields = ['schemaVersion', 'clinicId', 'uid', 'role', 'status', 'identityVersion', 'verifiedAfter'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.clinicId == 'main' && data.uid == uid
        && data.role == 'owner' && data.status == 'active'
        && data.identityVersion is int && data.identityVersion >= 1
        && data.identityVersion <= 9007199254740991
        && data.verifiedAfter is int && data.verifiedAfter >= 0
        && data.verifiedAfter <= 9007199254740991
        && request.auth.token.auth_time >= data.verifiedAfter;
    }
    function owner() {
      return database == '(default)' && request.auth != null && verifiedOwner(request.auth.uid)
        && activeOwner(get(/databases/$(database)/documents/clinics/main/members/$(request.auth.uid)).data, request.auth.uid);
    }
    function uuid(id) {
      return id is string && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
    }
    function hash(value) { return value is string && value.matches('[0-9a-f]{64}'); }
    function patientProfilePath(id) { return /databases/$(database)/documents/clinics/main/patientProfiles/$(id); }
    function patientOperationPath(id) { return /databases/$(database)/documents/clinics/main/patientOperations/$(id); }
    function patientFilePath(number) { return /databases/$(database)/documents/clinics/main/patientFiles/$(string(number)); }
    function patientCounterPath() { return /databases/$(database)/documents/clinics/main/counters/patientFiles; }
    function patientPositiveNumber(value) { return value is int && value >= 1 && value <= 2000000000; }
    function asciiDigits(value) {
      return value.matches('[^٠-٩۰-۹]*') ? value : value.replace('[٠۰]', '0').replace('[١۱]', '1').replace('[٢۲]', '2')
        .replace('[٣۳]', '3').replace('[٤۴]', '4').replace('[٥۵]', '5')
        .replace('[٦۶]', '6').replace('[٧۷]', '7').replace('[٨۸]', '8').replace('[٩۹]', '9');
    }
    function trimSpaces(value) {
      let spaces = '[\\x09-\\x0d\\x20\\x{00a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}\\x{2029}\\x{202f}\\x{205f}\\x{3000}\\x{feff}]';
      return value.replace('^' + spaces + '+|' + spaces + '+$', '');
    }
    function patientPreparedPhone(value) {
      let formatted = trimSpaces(asciiDigits(value));
      let digits = formatted.replace('[^0-9]', '');
      let international = digits.matches('00.*') ? digits[2:digits.size()] : digits;
      let canonical = international.matches('01.*') ? '20' + international[1:international.size()] : international;
      let valid = value.size() <= 60 && value == trimSpaces(value) && value.matches('[^\\x00-\\x1f\\x7f]*')
        && (value == '' || (formatted.matches('[+]?[0-9 ().-]+')
          && (!digits.matches('01.*') || digits.matches('01[0-9]{9}'))
          && canonical.matches('[1-9][0-9]{7,14}')
          && (!canonical.matches('20.*') || canonical.matches('201[0-9]{9}'))));
      return { 'valid': valid, 'key': value == '' ? null : hashing.sha256('patient-phone-v1:' + canonical).toHexString().lower() };
    }
    function calendarDay(value) {
      let year = int(value[0:4]);
      let month = int(value[5:7]);
      let day = int(value[8:10]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      return year >= 1900 && ((month == 2 && ((leap && day <= 29) || (!leap && day <= 28)))
        || (month in [4,6,9,11] && day <= 30) || (month in [1,3,5,7,8,10,12] && day <= 31));
    }
    function patientValidProfile(data, phone) {
      let fields = ['name', 'mobile', 'age', 'gender', 'firstVisit', 'notes', 'allergy'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.name is string && data.name == trimSpaces(data.name)
        && data.name.size() >= 1 && data.name.size() <= 200 && data.name.matches('[^\\x00-\\x1f\\x7f]*')
        && data.mobile is string && phone.valid
        && data.age is int && data.age >= 0 && data.age <= 120
        && data.gender is string && data.gender == trimSpaces(data.gender)
        && data.gender.size() <= 40 && data.gender.matches('[^\\x00-\\x1f\\x7f]*')
        && data.firstVisit is string
        && (data.firstVisit=='' || (data.firstVisit.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
          && calendarDay(data.firstVisit)))
        && data.notes is string && data.notes.size() <= 4000
        && data.notes.matches('[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*')
        && data.allergy is string && data.allergy.size() <= 1000
        && data.allergy.matches('[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*');
    }
    function patientValidEnvelope(data, id, phone) {
      let fields = ['schemaVersion', 'clinicId', 'recordId', 'fileNo', 'revision', 'lastOperationId', 'phoneKey', 'data'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && uuid(id) && data.recordId == id && patientPositiveNumber(data.fileNo)
        && patientPositiveNumber(data.revision) && uuid(data.lastOperationId)
        && data.phoneKey == phone.key && patientValidProfile(data.data, phone);
    }
    function patientValidCounter(data) {
      let fields = ['schemaVersion', 'clinicId', 'lastFileNo', 'lastOperationId'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && data.lastFileNo is int && data.lastFileNo >= 0 && data.lastFileNo <= 2000000000
        && ((data.lastFileNo == 0 && data.lastOperationId == null) || (data.lastFileNo != 0 && uuid(data.lastOperationId)));
    }
    function patientValidFile(data, key) {
      let fields = ['schemaVersion', 'clinicId', 'fileNo', 'recordId'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && patientPositiveNumber(data.fileNo) && key == string(data.fileNo) && uuid(data.recordId);
    }
    function patientValidReceipt(data, id) {
      // requestHash is a client retry fingerprint, NOT a server content signature.
      let fields = ['schemaVersion', 'clinicId', 'operationId', 'actorUid', 'recordId', 'fileNo', 'action', 'expectedRevision', 'resultRevision', 'requestHash', 'intentCreatedAt', 'intentRequestHash'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && uuid(id) && data.operationId == id && uuid(data.recordId) && patientPositiveNumber(data.fileNo)
        && data.actorUid == request.auth.uid && data.action in ['create', 'update', 'import']
        && data.expectedRevision is int && data.expectedRevision >= 0 && data.expectedRevision < 2000000000
        && patientPositiveNumber(data.resultRevision) && data.resultRevision == data.expectedRevision + 1
        && ((data.action in ['create','import']) == (data.expectedRevision == 0)) && hash(data.requestHash) && stamp(data.intentCreatedAt) && hash(data.intentRequestHash);
    }
    function patientNewReceipt(after) {
      let receipt = getAfter(patientOperationPath(after.lastOperationId));
      return !exists(patientOperationPath(after.lastOperationId)) && receipt != null
        && receipt.data.recordId == after.recordId;
    }
    function patientNewAllocation(after) {
      let beforeCounter = get(patientCounterPath());
      let afterCounter = getAfter(patientCounterPath());
      let afterFile = getAfter(patientFilePath(after.fileNo));
      let importing = getAfter(patientOperationPath(after.lastOperationId)).data.action=='import';
      // The changed counter's own rule validates both its schema and prior
      // state. Repeating those checks across companions exceeds Rules' budget.
      return beforeCounter != null
        && afterCounter != null && afterCounter.data.lastFileNo == (importing
          ? (beforeCounter.data.lastFileNo>after.fileNo?beforeCounter.data.lastFileNo:after.fileNo) : beforeCounter.data.lastFileNo+1)
        && (importing || afterCounter.data.lastFileNo == after.fileNo) && afterCounter.data.lastOperationId == after.lastOperationId
        && !exists(patientFilePath(after.fileNo)) && afterFile != null && afterFile.data.recordId == after.recordId;
    }
    function patientProfileWrite(before, after, id) {
      let phone = patientPreparedPhone(after.data.mobile);
      return patientValidEnvelope(after, id, phone) && patientNewReceipt(after)
        && ((before == null && after.revision == 1 && patientNewAllocation(after))
          || (before != null && after.fileNo == before.data.fileNo && after.revision == before.data.revision + 1
            && after.lastOperationId != before.data.lastOperationId));
    }
    function patientProfileChanged(before, after) {
      return after != null && ((before == null && after.data.revision == 1)
        || (before != null && after.data.revision == before.data.revision + 1));
    }
    function patientReceiptTransition(data) {
      let before = get(patientProfilePath(data.recordId));
      let after = getAfter(patientProfilePath(data.recordId));
      return patientProfileChanged(before, after) && after.data.lastOperationId == data.operationId
        && after.data.fileNo == data.fileNo && after.data.revision == data.resultRevision
        && ((before == null && data.expectedRevision == 0 && data.action in ['create','import'])
          || (before != null && data.expectedRevision == before.data.revision && data.action == 'update'))
        && profileIntent(data, after.data);
    }
    function patientFileTransition(data) {
      let before = get(patientProfilePath(data.recordId));
      let after = getAfter(patientProfilePath(data.recordId));
      return before == null && after != null && after.data.revision == 1 && after.data.fileNo == data.fileNo;
    }
    function patientCounterTransition(before, after) {
      let receipt = getAfter(patientOperationPath(after.lastOperationId));
      let profile = getAfter(patientProfilePath(receipt.data.recordId));
      return patientValidCounter(before) && after.diff(before).affectedKeys().hasOnly(['lastFileNo', 'lastOperationId'])
        && after.schemaVersion is int && after.lastFileNo is int
        && after.lastFileNo == (receipt.data.action=='import'
          ? (before.lastFileNo>receipt.data.fileNo?before.lastFileNo:receipt.data.fileNo) : before.lastFileNo+1) && after.lastOperationId != before.lastOperationId
        && after.lastFileNo <= 2000000000
        && receipt != null && !exists(patientOperationPath(after.lastOperationId)) && receipt.data.action in ['create','import']
        // The required create-only receipt rule already proves a new profile;
        // the profile rule supplies the schema and all allocation companions.
        && profile != null
        && profile.data.lastOperationId == after.lastOperationId && profile.data.fileNo == receipt.data.fileNo;
    }
    match /clinics/main/members/{uid} {
      allow get: if database == '(default)' && verifiedOwner(uid) && activeOwner(resource.data, uid);
      allow list, create, update, delete: if false;
    }
    match /clinics/main/patientProfiles/{id} {
      allow get: if owner() && uuid(id);
      allow list: if owner() && 'limit' in request.query
        && request.query.limit is int && request.query.limit >= 1 && request.query.limit <= 50;
      allow create, update: if owner() && patientProfileWrite(resource, request.resource.data, id);
      allow delete: if false;
    }
    match /clinics/main/patientOperations/{id} {
      allow get: if owner() && uuid(id) && (!exists(patientOperationPath(id)) || resource.data.actorUid == request.auth.uid);
      allow create: if owner() && patientValidReceipt(request.resource.data, id) && patientReceiptTransition(request.resource.data);
      allow list, update, delete: if false;
    }
    match /clinics/main/patientFiles/{key} {
      allow get: if owner() && key.matches('[1-9][0-9]{0,9}') && int(key) <= 2000000000;
      allow create: if owner() && patientValidFile(request.resource.data, key) && patientFileTransition(request.resource.data);
      allow list: if owner() && boundedQuery();
      allow update, delete: if false;
    }
    match /clinics/main/counters/patientFiles {
      allow get: if owner();
      // Trusted setup must seed {lastFileNo:0,lastOperationId:null} separately.
      // Missing/corrupt counters fail closed; a client never restarts numbering.
      allow update: if owner() && patientCounterTransition(resource.data, request.resource.data);
      allow list: if owner() && 'limit' in request.query && request.query.limit==1;
      allow create, delete: if false;
    }








    function contactRecordPath(id) { return /databases/$(database)/documents/clinics/main/contactRecords/$(id); }
    function contactOperationPath(id) { return /databases/$(database)/documents/clinics/main/contactOperations/$(id); }
    function contactPhonePath(key) { return /databases/$(database)/documents/clinics/main/contactPhones/$(key); }


    function contactPreparedPhone(value) {
      let formatted = trimSpaces(asciiDigits(value));
      let digits = formatted.replace('[^0-9]', '');
      let international = digits.matches('00.*') ? digits[2:digits.size()] : digits;
      let canonical = international.matches('01.*') ? '20' + international[1:international.size()] : international;
      let valid = value.size() <= 60 && value.matches('[^\\x00-\\x1f\\x7f]*')
        && formatted.matches('[+]?[0-9 ().-]+')
        && (!digits.matches('01.*') || digits.matches('01[0-9]{9}'))
        && canonical.matches('[1-9][0-9]{7,14}')
        && (!canonical.matches('20.*') || canonical.matches('201[0-9]{9}'));
      return { 'valid': valid, 'key': hashing.sha256('contact-phone-v1:' + canonical).toHexString().lower() };
    }

    function contactValidContact(data, id, phone) {
      return data is map && data.keys().hasAll(['id', 'name', 'mobile', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'mobile', 'createdAt', 'notes', 'campaignConsent'])
        && data.id == id && data.name is string && trimSpaces(data.name).size() > 0
        && data.name.size() <= 200 && data.name.matches('[^\\x00-\\x1f\\x7f]*')
        && data.mobile is string && phone.valid
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000
          && data.notes.matches('[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*')))
        && data.createdAt is string
        && data.createdAt.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,3})?Z')
        && calendarDay(data.createdAt)
        && (!('campaignConsent' in data) || (exact(data.campaignConsent,['status','phone','recordedAt'])
          && data.campaignConsent.status in ['allowed','declined']
          && data.campaignConsent.phone is string && data.campaignConsent.phone.matches('[1-9][0-9]{7,14}')
          && hashing.sha256('contact-phone-v1:'+data.campaignConsent.phone).toHexString().lower()==phone.key
          && stamp(data.campaignConsent.recordedAt)));
    }
    function contactValidRecord(data, id, phone) {
      let fields = ['schemaVersion', 'clinicId', 'recordId', 'revision', 'deleted', 'lastOperationId', 'phoneKey', 'data'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && uuid(id) && data.recordId == id && uuid(data.lastOperationId)
        && data.revision is int && data.revision >= 1 && data.revision <= 2000000000
        && data.deleted is bool
        && (data.deleted ? data.data == null && data.phoneKey == null
          : data.phoneKey == phone.key && contactValidContact(data.data, id, phone));
    }
    function contactValidReceipt(data, id) {
      // requestHash is the client's stable JSON retry fingerprint, NOT a server
      // recomputed content signature. Explicit actor/record/action/revision links
      // are enforced below, and the receipt is create-only. Owner access only.
      let fields = ['schemaVersion', 'clinicId', 'operationId', 'actorUid', 'recordId', 'action', 'expectedRevision', 'resultRevision', 'requestHash', 'intentCreatedAt', 'intentRequestHash'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && uuid(id) && data.operationId == id && uuid(data.recordId)
        && data.actorUid == request.auth.uid
        && data.action in ['create', 'update', 'delete']
        && data.expectedRevision is int && data.expectedRevision >= 0 && data.expectedRevision < 2000000000
        && data.resultRevision is int && data.resultRevision == data.expectedRevision + 1
        && ((data.action == 'create') == (data.expectedRevision == 0)) && hash(data.requestHash) && stamp(data.intentCreatedAt) && hash(data.intentRequestHash);
    }
    function contactIndexMatches(data, key, id) {
      let fields = ['schemaVersion', 'clinicId', 'phoneKey', 'recordId'];
      return data is map && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.clinicId == 'main'
        && hash(key) && data.phoneKey == key && uuid(id) && data.recordId == id;
    }
    function contactRecordTransition(before, after, id, phone) {
      return contactValidRecord(after, id, phone)
        && (before == null ? after.revision == 1 && !after.deleted
          : !before.data.deleted && before.data.recordId == id
            && after.revision == before.data.revision + 1
            && after.lastOperationId != before.data.lastOperationId
            && (after.deleted || after.data.createdAt == before.data.data.createdAt));
    }
    function contactRecordReceipt(before, after) {
      let op = getAfter(contactOperationPath(after.lastOperationId));
      return !exists(contactOperationPath(after.lastOperationId)) && op != null
        // A receipt absent before and present after MUST be created in this
        // batch. Its own create rule validates schema; don't repeat it here.
        && op.data.recordId == after.recordId;
    }
    function contactRecordPhones(before, after, oldKey, nextKey) {
      return (before == null || get(contactPhonePath(oldKey)).data.recordId == after.recordId)
        && (oldKey == '' || oldKey == nextKey || !existsAfter(contactPhonePath(oldKey)))
        && (nextKey == '' || getAfter(contactPhonePath(nextKey)).data.recordId == after.recordId);
    }
    function contactContactWrite(before, after, id) {
      let oldKey = before == null ? '' : before.data.phoneKey;
      let phone = after.deleted ? { 'valid': true, 'key': '' } : contactPreparedPhone(after.data.mobile);
      return contactRecordTransition(before, after, id, phone) && contactRecordReceipt(before, after)
        && contactRecordPhones(before, after, oldKey, phone.key);
    }
    function contactCompanionChanged(before, after) {
      // Full schema/phone checks belong to the record's own write rule. An
