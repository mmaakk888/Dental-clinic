        && p.keys==(p.kind=='templates'?a.keys.concat(b.keys).concat(d.keys).concat(e.keys):[])
        && p.byteSize==a.byteSize+b.byteSize+d.byteSize+e.byteSize;
    }
function st_scalarShape(p,c) {
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize','rows'])
        && p.rows is list && p.rows.size()==1 && p.rows[0]==st_scalarSource(c,p.index) && st_scalarValid(c,p.index,p.rows[0])
        && p.byteSize==0 && p.ids==[] && p.nameKeys==[] && p.keys==[];
    }
function st_routeShape(p,c) { let row=p.rows[0]; let route=row.route;
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize','rows'])
        && p.rows is list && p.rows.size()==1 && exact(row,['route','serviceIndex','labIndex','materialIndex'])
        && exact(route,['serviceId','labId','materialId']) && uuid(route.serviceId) && uuid(route.labId) && uuid(route.materialId)
        && route==c.data.routes[p.index] && row.serviceIndex is int && row.serviceIndex>=0
        && row.labIndex is int && row.labIndex>=0 && row.labIndex<p.referenceRevisions.labs.size()
        && row.materialIndex is int && row.materialIndex>=0 && p.byteSize==0 && p.ids==[route.serviceId] && p.nameKeys==[] && p.keys==[];
    }
function st_routeLeaf(p,c) { let shape=get(st_proofPath(p.operationId,'routes-shape',0,p.index)).data;
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize','rows'])
        && p.rows==shape.rows && p.ids==shape.ids && p.nameKeys==[] && p.keys==[] && p.byteSize==0
        && st_route(p,c,p.rows[0],p.index);
    }
function st_dependencyLeaf(p,c) {
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize','rows'])
        && p.rows is list && p.rows.size()==1 && p.byteSize==0 && p.ids==[] && p.nameKeys==[] && p.keys==[]
        && st_dep(p,c,p.rows[0],p.index);
    }
function st_scalarLeaf(p,c) {
      let shape=get(st_proofPath(p.operationId,'scalar-shape',0,p.index)).data;
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize','rows'])
        && p.rows==shape.rows
        && p.byteSize==st_scalarBytes(c,p.index,p.rows[0]) && p.ids==[] && p.nameKeys==[] && p.keys==[];
    }
function st_validatedLeaf(p,c) {
      let a=get(st_proofPath(p.operationId,p.kind+'-shape',0,p.index)).data;
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize','rows'])
        && p.rows==a.rows && p.ids==a.ids && p.nameKeys==a.nameKeys && p.keys==a.keys
        && p.byteSize==st_rowBytes(p,c,p.rows[0],p.index);
    }
function st_textWitness(p,c,kind) {
      let v=p.rows[0];
      let source=kind=='medications'?c.data.medications[p.index]:kind=='templates'?c.data.whatsapp.templates[p.index]:c.data.costs[p.index];
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize','rows'])
        && p.rows is list && p.rows.size()==1 && v==source && p.byteSize==0 && p.ids==[] && p.nameKeys==[] && p.keys==[]
        && (kind=='medications'?st_text(v.category,80,false,false) && st_text(v.defaultDosage,500,false,true) && st_text(v.defaultDuration,200,false,false)
          :kind=='templates'?st_text(v.title,80,true,false) && st_text(v.text,4000,false,true):st_text(v.unitLabel,40,true,false) && st_name(v.name,80));
    }
function st_metadata(kind,v) {
      return kind=='medications'?exact(v,['medicationId','name','category','defaultDosage','defaultDuration','active']) && uuid(v.medicationId) && st_name(v.name,160) && v.active is bool
        :kind=='templates'?exact(v,['templateId','key','title','text']) && uuid(v.templateId)
          && v.key in ['reminderTomorrow','newAppt','postOp','accountBalance','greeting','offer','extraction','filling','rootCanal','custom']
        :exact(v,['materialId','name','category','unitLabel','billingBasis','unitCostCents','active']) && uuid(v.materialId)
          && v.category in ['fixed','removable','other'] && v.billingBasis in ['per-unit','whole-case'] && (v.unitCostCents==null || money(v.unitCostCents)) && v.active is bool;
    }
function st_metadataWitness(p,c,kind) {
      let text=get(st_proofPath(p.operationId,kind+'-text',0,p.index)).data;
      let v=p.rows[0];
      let key=kind in ['medications','costs']?nameKey(v.name):'';
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize','rows'])
        && p.rows==text.rows && st_metadata(kind,v) && p.byteSize==0
        && p.ids==[st_rowId(kind,v)] && p.nameKeys==(kind in ['medications','costs']?[key]:[]) && !(key in ['__proto__','prototype','constructor'])
        && (kind=='templates' || key.size()>0) && p.keys==(kind=='templates'?[v.key]:[]);
    }
function st_reuseScalar(c,old,p) {
      return p.level==0 ? st_scalarSource(c,p.index)==st_scalarSource(old,p.index)
          && (p.index!=0 || c.target!='clinicSettings' || c.data.medications.size()==old.data.medications.size()
            && c.data.whatsapp.templates.size()==old.data.whatsapp.templates.size())
        : c.target=='clinicSettings' ? c.data.identity==old.data.identity && c.data.theme==old.data.theme
          && c.data.content==old.data.content && c.data.whatsapp.senderNumber==old.data.whatsapp.senderNumber
          && c.data.whatsapp.autoConfirmOnAppt==old.data.whatsapp.autoConfirmOnAppt
          && c.data.whatsapp.autoRemind24h==old.data.whatsapp.autoRemind24h
          && c.data.whatsapp.autoPostOpOnAttended==old.data.whatsapp.autoPostOpOnAttended
          && c.data.medications.size()==old.data.medications.size() && c.data.whatsapp.templates.size()==old.data.whatsapp.templates.size()
        : c.data==old.data;
    }
function st_reuseRows(c,old,p) {
      let span=st_span(p.kind,p.level);
      let start=p.index*span;
      let a=p.kind=='medications'?c.data.medications:p.kind=='templates'?c.data.whatsapp.templates:p.kind=='costs'?c.data.costs:c.data.routes;
      let b=p.kind=='medications'?old.data.medications:p.kind=='templates'?old.data.whatsapp.templates:p.kind=='costs'?old.data.costs:old.data.routes;
      return start<a.size() && start<b.size()
        && a[start:(start+span<a.size()?start+span:a.size())]==b[start:(start+span<b.size()?start+span:b.size())];
    }
function st_reuse(p,c) {
      let op=p.reuseFromOperationId;
      let source=get(st_proofPath(op,p.kind,p.level,p.index)).data;
      let i=get(intentPath(op)).data;
      let r=get(domainReceiptPath('settings',op)).data;
      return c.target!='prostheticRouting' && uuid(op) && op!=p.operationId && !('reuseFromOperationId' in source)
        && i.kind=='settings' && i.status=='committed' && i.actorUid==request.auth.uid
        // A v2 receipt is immutable and can only be created together with this
        // exact committed same-actor intent. Its own creation Rule already
        // checked actor/target/revisions/time; do not repeat the entire envelope.
        && r.validationVersion==2 && st_span(p.kind,p.level)<=(p.kind=='templates'?4:16)
        && p.diff(source).affectedKeys().hasOnly(['operationId','referenceRevisions','reuseFromOperationId'])
        && p.kind in ['scalar','medications','templates','costs','routes','dependencies']
        && (p.kind=='scalar'?st_reuseScalar(c,i.command,p)
          :p.kind=='dependencies'?c.data==i.command.data && p.referenceRevisions==source.referenceRevisions
          :st_reuseRows(c,i.command,p) && (p.kind!='routes' || p.referenceRevisions==source.referenceRevisions));
    }
function st_proofWrite(p,id) { let i=get(intentPath(p.operationId)).data;
      let kind=st_valueKind(p.kind);
      let count=st_count(i.command,kind,p.referenceRevisions);
      return st_proofBase(p,id,i,i.command,count,kind) && ('reuseFromOperationId' in p?st_reuse(p,i.command)
        :p.kind.matches('.*-unique-.*')?p.index==0 && st_medicationUniqueWitness(p,i.command)
        :p.kind=='routing-refs-shape'?p.index<2 && st_routingRefsWitness(p)
        :p.kind==kind?p.level==0?(p.kind=='scalar'?st_scalarLeaf(p,i.command):p.kind=='routes'?st_routeLeaf(p,i.command):p.kind=='dependencies'?st_dependencyLeaf(p,i.command):st_validatedLeaf(p,i.command)):st_group(p,i.command,count)
        :p.kind=='scalar-shape'?st_scalarShape(p,i.command)
        :p.kind=='routes-shape'?st_routeShape(p,i.command)
        :p.kind.matches('.*-text')?st_textWitness(p,i.command,kind)
        :st_metadataWitness(p,i.command,kind)); }
function st_uniqueMedicationField(c,kind,field) {
      let count=kind=='medications'?c.data.medications.size():kind=='costs'?c.data.costs.size():c.data.routes.size();
      let level=st_level(kind,count);
      let span=st_span(kind,level);
      let prefix=c.operationId+'-'+kind+'-'+string(level)+'-';
      let a=st_child(prefix,0,true,null);
      let b=st_child(prefix,1,span<count,null);
      let d=st_child(prefix,2,span*2<count,null);
      let e=st_child(prefix,3,span*3<count,null);
      let n=count>span*3?4:count>span*2?3:count>span?2:1;
      let values=st_join(a[field],b[field],d[field],e[field],n);
      return values.toSet().size()==values.size();
    }
function st_medicationUniqueWitness(p,c) {
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize'])
        && p.ids==[] && p.nameKeys==[] && p.keys==[] && p.byteSize==0
        && st_uniqueMedicationField(c,st_valueKind(p.kind),p.kind.matches('.*-unique-ids')?'ids':'nameKeys');
    }
function st_labMetadata(refs,n) { return n>=refs.labs.size() || exact(refs.labs[n],['labId','revision']) && uuid(refs.labs[n].labId)
      && revision(refs.labs[n].revision) && (n==0 || refs.labs[n-1].labId<refs.labs[n].labId); }
function st_routingRefsWitness(p) { let start=p.index*3;
      return st_proofKeys(p,['schemaVersion','clinicId','operationId','target','recordId','kind','level','index','referenceRevisions','ids','nameKeys','keys','byteSize'])
        && p.ids==[] && p.nameKeys==[] && p.keys==[] && p.byteSize==0
        && st_labMetadata(p.referenceRevisions,start) && st_labMetadata(p.referenceRevisions,start+1) && st_labMetadata(p.referenceRevisions,start+2);
    }

      allow get: if owner() && id.matches('[0-9a-f-]{36}-((scalar|routes)(-shape)?|(medications|costs)-unique-(ids|names)|routes-unique-ids|routing-refs-shape|(medications|templates|costs)(-(shape|text))?|dependencies)-[0-4]-[0-9]{1,3}');
      allow create: if owner() && st_proofWrite(request.resource.data,id);
      allow list,update,delete: if false;
    

}
}
match /{document=**} { allow read, write: if false; }
}
}


