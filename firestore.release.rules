          || (c.action=='progress' && s.data.diff(before.data.data).affectedKeys().hasOnly(['notes','treatmentStage','rootCanalStatus','visitStatus'])
            && s.data.notes==c.changes.notes && s.data.treatmentStage==c.changes.treatmentStage
            && s.data.rootCanalStatus==c.changes.rootCanalStatus && s.data.visitStatus==c.changes.visitStatus))));
    }
    function clinicalReceipt(r,id) {
      let i=getAfter(intentPath(id)).data;
      let c=i.command;
      let a=getAfter(anyPath('patientAccounts',c.patientId)).data;
      let s=getAfter(anyPath('patientSessions',c.sessionId)).data;
      return exact(r,['schemaVersion','clinicId','operationId','actorUid','patientId','sessionId','action','expectedRevision','resultRevision','createdAt','requestHash','fileNo'])
        && r.schemaVersion is int && r.schemaVersion==1 && r.clinicId=='main' && r.operationId==id && r.actorUid==request.auth.uid
        && r.patientId==c.patientId && r.sessionId==c.sessionId && r.action==c.action && r.expectedRevision==c.expectedRevision
        && r.resultRevision==c.expectedRevision+1 && r.createdAt==i.createdAt && hash(r.requestHash)
        && r.fileNo==a.fileNo && s.fileNo==r.fileNo && a.revision==r.resultRevision
        && a.lastOperationId==id && s.lastOperationId==id && coupledIntent('clinical',id)
        && (c.action!='visit' || clinicalMetadata(c.data));
    }
    function clinicalCash(r,id) {
      let i=getAfter(intentPath(id)).data;
      let c=i.command;
      let op=getAfter(domainReceiptPath('clinical',id)).data;
      return exact(r,['schemaVersion','clinicId','receiptId','patientId','sessionId','fileNo','amountCents','date','note','createdAt','actorUid','paymentMethod'])
        && i.kind=='clinical' && r.schemaVersion is int && r.schemaVersion==1 && r.clinicId=='main' && r.receiptId==id
        && r.patientId==c.patientId && r.sessionId==c.sessionId && r.fileNo==op.fileNo && op.operationId==id
        && r.amountCents==collected(c) && r.amountCents>0 && r.createdAt==i.createdAt && r.actorUid==request.auth.uid && r.paymentMethod=='cash'
        && ((c.action=='visit' && r.date==c.data.date && r.note=='') || (c.action=='payment' && r.date==c.date && r.note==c.note));
    }
    match /clinics/main/patientAccounts/{id} {
      allow get: if owner() && uuid(id);
      allow create,update: if owner() && clinicalAccountWrite(resource,request.resource.data,id);
      allow list: if owner() && boundedQuery();
      allow delete: if false;
    }
    match /clinics/main/patientSessions/{id} {
      allow get: if owner() && uuid(id);
      allow list: if owner() && boundedQuery();
      allow create,update: if owner() && clinicalSessionWrite(resource,request.resource.data,id);
      allow delete: if false;
    }
    match /clinics/main/patientReceipts/{id} {
      allow get: if owner() && uuid(id);
      allow list: if owner() && boundedQuery();
      allow create: if owner() && uuid(id) && clinicalCash(request.resource.data,id);
      allow update,delete: if false;
    }
    match /clinics/main/clinicalOperations/{id} {
      allow get: if owner() && uuid(id);
      allow create: if owner() && uuid(id) && clinicalReceipt(request.resource.data,id);
      allow list,update,delete: if false;
    }
    match /clinics/main/clinicalSessionProofs/{id} {
      allow get: if owner() && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}-(0-([0-9]|[12][0-9]|3[01])|1-[0-7]|2-[01])');
      allow create: if owner() && clinicalProofWrite(request.resource.data,id);
      allow list,update,delete: if false;
    }

    function appointmentText(v,n,multiline) {
      let spaces='[\\x09-\\x0d\\x20\\x{00a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}\\x{2029}\\x{202f}\\x{205f}\\x{3000}\\x{feff}]';
      return v is string && v.size()<=n && (v=='' || ((multiline || !v.matches(spaces+'.*|.*'+spaces))
        && (multiline ? v.matches('[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\p{Cf}\\p{Cs}\\p{Zl}\\p{Zp}]*')
          : v.matches('[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Zl}\\p{Zp}]*'))));
    }
    function appointmentStart(d) { return int(d.time[0:2])*60+int(d.time[3:5]); }
    function appointmentOccupied(d) { return d.status in ['scheduled','confirmed','waiting','attended']; }
    function appointmentSlot(id,d) { return {'recordId':id,'startMinute':appointmentStart(d),'endMinute':appointmentStart(d)+d.durationMinutes}; }
    function preparedAppointment(c) {
      let d=c.data;
      return exact(c,['operationId','recordId','expectedRevision','createdAt','data']) && uuid(c.recordId) && expected(c.expectedRevision)
        && exact(d,['patientRecordId','patientName','phone','date','time','durationMinutes','status','reason','notes','doctorName','appointmentType','isFollowUp','isWalkIn'])
        && (d.patientRecordId==null || uuid(d.patientRecordId)) && d.patientName is string && d.patientName.size()>0 && d.patientName.size()<=200
        && d.phone is string && (d.phone=='' || (d.phone.matches('[1-9][0-9]{7,14}') && (!d.phone.matches('20.*') || d.phone.matches('201[0-9]{9}'))))
        && day(d.date) && d.time is string && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && d.durationMinutes is int && d.durationMinutes>=1 && d.durationMinutes<=1440 && appointmentStart(d)+d.durationMinutes<=1440
        && d.status in ['scheduled','confirmed','waiting','attended','cancelled','apologized','no_show']
        // Prepared drafts are exact and bounded, not successful bookings. The
        // required record/day writes below collectively validate text content.
        && d.reason is string && d.reason.size()<=200 && d.notes is string && d.notes.size()<=4000
        && d.doctorName is string && d.doctorName.size()<=200 && d.appointmentType is string && d.appointmentType.size()<=80
        && d.isFollowUp is bool && d.isWalkIn is bool;
    }
    function appointmentChange(r,date) {
      return r.dayChanges[0].date==date ? r.dayChanges[0] : r.dayChanges[1];
    }
    function appointmentChangeShape(p) {
      // Dates are compared with the already validated command/old record below;
      // repeat calendar parsing here needlessly exceeds the cross-day budget.
      return exact(p,['date','expectedDayRevision','removeAt','insertAt']) && expected(p.expectedDayRevision)
        && p.removeAt is int && p.removeAt>=-1 && p.removeAt<200 && p.insertAt is int && p.insertAt>=-1 && p.insertAt<200;
    }
    function appointmentDayFence(p,op) {
      let a=getAfter(anyPath('appointmentDays',p.date)).data;
      return a.lastOperationId==op && a.revision==p.expectedDayRevision+1 && a.slotIndexVersion==2;
    }
    function appointmentReceipt(r,id) {
      let i=getAfter(intentPath(id)).data;
      let c=i.command;
      let old=get(anyPath('appointmentRecords',c.recordId));
      let a=getAfter(anyPath('appointmentRecords',c.recordId)).data;
      let p=r.dayChanges;
      let two=old!=null && old.data.data.date!=c.data.date;
      return exact(r,['schemaVersion','clinicId','operationId','recordId','actorUid','expectedRevision','resultRevision','createdAt','requestHash','dayIndexVersion','dayChanges'])
        && r.schemaVersion is int && r.schemaVersion==1 && r.clinicId=='main' && uuid(id) && r.operationId==id && r.recordId==c.recordId
        && r.actorUid==request.auth.uid && hash(r.requestHash) && r.expectedRevision==c.expectedRevision && r.resultRevision==c.expectedRevision+1
        && r.createdAt==i.createdAt && r.dayIndexVersion is int && r.dayIndexVersion==2 && coupledIntent('appointment',id)
        && a.lastOperationId==id && a.revision==r.resultRevision
        && p is list && p.size()==(two?2:1) && appointmentChangeShape(p[0])
        && (two ? appointmentChangeShape(p[1])
            && int(p[0].date.replace('-',''))<int(p[1].date.replace('-',''))
            && (p[0].date==old.data.data.date || p[1].date==old.data.data.date)
            && (p[0].date==c.data.date || p[1].date==c.data.date) && appointmentDayFence(p[1],id)
          : p[0].date==c.data.date)
        && appointmentDayFence(p[0],id);
    }
    function appointmentRecordWrite(before,a,id) {
      let r=getAfter(domainReceiptPath('appointment',a.lastOperationId)).data;
      let i=getAfter(intentPath(a.lastOperationId)).data;
      let c=i.command;
      return exact(a,['schemaVersion','clinicId','recordId','revision','lastOperationId','data']) && a.schemaVersion is int && a.schemaVersion==1
        && a.clinicId=='main' && uuid(id) && a.recordId==id && uuid(a.lastOperationId) && i.kind=='appointment' && i.status=='committed'
        && !exists(domainReceiptPath('appointment',a.lastOperationId)) && r.recordId==id && r.operationId==a.lastOperationId
        && c.recordId==id && a.data==c.data && revision(a.revision) && a.revision==c.expectedRevision+1
        && appointmentText(c.data.patientName,200,false) && appointmentText(c.data.reason,200,false) && appointmentText(c.data.notes,4000,true)
        && (before==null ? c.expectedRevision==0 : before.data.revision==c.expectedRevision && before.data.recordId==id)
        && (c.data.patientRecordId==null || exists(patientProfilePath(c.data.patientRecordId)));
    }
    // Inductive native list transition: preserve every other slot without
    // evaluating 200 rows. Only the removed own slot and new neighbors change.
    // Empty slices are explicitly guarded for the Firestore Rules runtime.
    function appointmentRemoved(slots,at) {
      return at<0 ? slots : (at==0?[]:slots[0:at]).concat(at+1<slots.size()?slots[at+1:slots.size()]:[]);
    }
    function appointmentInserted(slots,at,slot) {
      return at<0 ? slots : (at==0?[]:slots[0:at]).concat([slot]).concat(at<slots.size()?slots[at:slots.size()]:[]);
    }
    function appointmentDaySlots(beforeSlots,a,p,c,old) {
      let remove=old!=null && old.data.data.date==a.recordId && appointmentOccupied(old.data.data);
      let insert=c.data.date==a.recordId && appointmentOccupied(c.data);
      let remaining=appointmentRemoved(beforeSlots,p.removeAt);
      let slot=appointmentSlot(c.recordId,c.data);
      return (remove ? p.removeAt>=0 && p.removeAt<beforeSlots.size() && beforeSlots[p.removeAt]==appointmentSlot(c.recordId,old.data.data) : p.removeAt==-1)
        && (insert ? p.insertAt>=0 && p.insertAt<=remaining.size()
          && (p.insertAt==0 || remaining[p.insertAt-1].endMinute<=slot.startMinute)
          && (p.insertAt==remaining.size() || slot.endMinute<=remaining[p.insertAt].startMinute) : p.insertAt==-1)
        && a.slots==appointmentInserted(remaining,p.insertAt,slot);
    }
    function appointmentDayWrite(before,a,date) {
      let r=getAfter(domainReceiptPath('appointment',a.lastOperationId)).data;
      let c=getAfter(intentPath(a.lastOperationId)).data.command;
      let old=get(anyPath('appointmentRecords',c.recordId));
      let p=appointmentChange(r,date);
      return exact(a,['schemaVersion','clinicId','recordId','revision','lastOperationId','slots','slotIndexVersion'])
        && a.schemaVersion is int && a.schemaVersion==1 && a.clinicId=='main' && day(date) && a.recordId==date && a.slotIndexVersion is int && a.slotIndexVersion==2
        && a.slots is list && a.slots.size()<=200 && uuid(a.lastOperationId) && r.operationId==a.lastOperationId && p.date==date
        && !exists(domainReceiptPath('appointment',a.lastOperationId)) && revision(a.revision) && a.revision==p.expectedDayRevision+1
        && (before==null ? p.expectedDayRevision==0 : before.data.slotIndexVersion==2 && before.data.revision==p.expectedDayRevision)
        && (date!=c.data.date || (appointmentText(c.data.doctorName,200,false) && appointmentText(c.data.appointmentType,80,false)))
        && appointmentDaySlots(before==null?[]:before.data.slots,a,p,c,old);
    }
    match /clinics/main/appointmentRecords/{id} {
      allow get: if owner() && uuid(id);
      allow list: if owner() && boundedQuery();
      allow create,update: if owner() && appointmentRecordWrite(resource,request.resource.data,id);
      allow delete: if false;
    }
    match /clinics/main/appointmentDays/{date} {
      allow get: if owner() && day(date);
      allow list: if owner() && boundedQuery();
      allow create,update: if owner() && appointmentDayWrite(resource,request.resource.data,date);
      allow delete: if false;
    }
    match /clinics/main/appointmentOperations/{id} {
      allow get: if owner() && uuid(id);
      allow create: if owner() && appointmentReceipt(request.resource.data,id);
      allow list,update,delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

