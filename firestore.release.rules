    function exact(d, keys) { return d is map && d.keys().hasAll(keys) && d.keys().hasOnly(keys); }
    function stamp(v) {
      return v is string && v.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z')
        && calendarDay(v);
    }
    function boundedQuery() { return 'limit' in request.query && request.query.limit is int && request.query.limit >= 1 && request.query.limit <= 50; }
    function intentPath(id) { return /databases/$(database)/documents/clinics/main/operationIntents/$(id); }
    function receiptCollection(kind) {
      return {'patient-profile':'patientOperations','contact':'contactOperations','catalog':'catalogOperations','clinical':'clinicalOperations',
        'appointment':'appointmentOperations','prosthetic':'prostheticOperations','expense':'expenseOperations','settings':'settingsOperations'}[kind];
    }
    function domainReceiptPath(kind, id) {
      return /databases/$(database)/documents/clinics/main/$(receiptCollection(kind))/$(id);
    }
    function intentEnvelope(d, id) {
      return exact(d, ['schemaVersion','clinicId','recordId','operationId','actorUid','kind','requestHash','status','revision','createdAt','command'])
        && d.schemaVersion is int && d.schemaVersion == 1 && d.clinicId == 'main'
        && uuid(id) && d.recordId == id && d.operationId == id && d.actorUid == request.auth.uid
        && d.kind in ['patient-profile','contact','catalog','clinical','appointment','prosthetic','expense','settings']
        && hash(d.requestHash) && stamp(d.createdAt) && d.command is map && d.command.operationId == id
        && d.status in ['prepared','committed','cancelled'] && d.revision is int
        && ((d.status == 'prepared' && d.revision == 1) || (d.status != 'prepared' && d.revision == 2));
    }
    function preparedProfile(c) {
      let p=c.profile;
      return (c.action=='import' ? exact(c,['operationId','recordId','expectedRevision','action','profile','fileNo']) && patientPositiveNumber(c.fileNo)
          : exact(c, ['operationId','recordId','expectedRevision','action','profile']))
        && uuid(c.operationId) && uuid(c.recordId) && c.expectedRevision is int && c.expectedRevision >= 0 && c.expectedRevision < 2000000000
        && c.action in ['create','update','import'] && ((c.action in ['create','import']) == (c.expectedRevision == 0))
        // Private preparation is exact/bounded; the REQUIRED profile write
        // performs full phone, calendar and text validation before any file
        // number/counter/receipt can commit. Avoid duplicating that expensive
        // validation in the journal-create expression budget.
        && exact(p,['name','mobile','age','gender','firstVisit','notes','allergy'])
        && p.name is string && p.name.size()>0 && p.name.size()<=200 && p.mobile is string && p.mobile.size()<=60
        && p.age is int && p.age>=0 && p.age<=120 && p.gender is string && p.gender.size()<=40
        && p.firstVisit is string && p.firstVisit.size()<=10 && p.notes is string && p.notes.size()<=4000
        && p.allergy is string && p.allergy.size()<=1000;
    }
    function preparedContact(c) {
      let d=c.contact;
      return exact(c, ['operationId','recordId','expectedRevision','action','contact'])
        && uuid(c.operationId) && uuid(c.recordId) && c.expectedRevision is int && c.expectedRevision >= 0 && c.expectedRevision < 2000000000
        && c.action in ['create','update','delete'] && ((c.action == 'create') == (c.expectedRevision == 0))
        // Preparation is private and bounded, not a usable contact or consent.
        // Its mutually REQUIRED contact record performs full phone/calendar/
        // text/consent validation before any receipt/index can commit.
        && (c.action == 'delete' ? d == null : d is map && d.keys().hasAll(['id','name','mobile','createdAt'])
          && d.keys().hasOnly(['id','name','mobile','createdAt','notes','campaignConsent']) && d.id==c.recordId
          && d.name is string && d.name.size()>0 && d.name.size()<=200 && d.mobile is string && d.mobile.size()<=60
