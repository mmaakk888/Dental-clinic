{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "build": "vite build && node scripts/build-server.mjs && node scripts/precompress-assets.mjs",
    "start": "node scripts/start-server.mjs",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "clean": "node scripts/clean-build.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=3 --test-timeout=180000 src/utils/*.test.ts src/components/appointments/*.test.ts server/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "14.5.0",
    "html2canvas": "1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  },
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@11.19.0",
  "overrides": {
    "source-map-js": "1.2.2",
    "@grpc/grpc-js": "1.14.5",
    "uuid": "11.1.1"
  }
}
