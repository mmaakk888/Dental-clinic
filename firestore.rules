rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The current web app does not yet use Firebase Authentication. Keep the
    // database closed until the authenticated, role-based data layer lands.
    // This prevents patient and financial records from being publicly readable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
