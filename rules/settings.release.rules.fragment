    function st_sections() { return ['patients','contacts','appointments','lab','summary','settings']; }
    function st_homeSections() { return ['actions','metrics','schedule','followUp']; }
    function st_mobile(m) {
      return exact(m,['order','size','showLabels','visibleCount','moreSections']) && st_order(m.order,st_sections(),true)
