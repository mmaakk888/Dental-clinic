    function st_logo(v) { return v==null || exact(v,['mimeType','base64','width','height'])
      && v.mimeType in ['image/png','image/jpeg'] && v.width is int && v.width>=1 && v.width<=2048
      && v.height is int && v.height>=1 && v.height<=2048 && v.width*v.height<=4000000
      && v.base64 is string && v.base64.size()>0 && v.base64.size()<=65536
      && v.base64.matches('([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?'); }
    function st_firstValid(c,n,v) {
      return n==0 ? st_outline(c.data)
