        : n<15 ? (n!=9 || exact(c.data.content.tiles,st_sections())) && exact(v,['title','desc']) && st_text(v.title,80,true,false) && st_text(v.desc,400,false,false)
        : n<21 ? (n!=15 || exact(c.data.content.tabs,['info','chart','sessions','finance','lab'])
          && exact(c.data.content.navigationLabels,['home','patients','contacts','appointments','lab','summary','settings']))
          && st_text(v.first,80,true,false) && st_text(v.second,80,true,false)
