        : n==2 ? st_phone(v.phone) && st_text(v.address,400,false,true) && v.logoRecordId in [null,'clinicLogo']
        : n==3 ? exact(c.data.theme,['primary','secondary','accent','background','fontFamily','customFontUrl'])
          && v.primary.matches('#[0-9a-f]{6}') && v.secondary.matches('#[0-9a-f]{6}') && v.accent.matches('#[0-9a-f]{6}') && v.background.matches('#[0-9a-f]{6}')
        : st_font(v);
    }
    function st_navValid(n,v) { return n==5 ? st_text(v.homeSubtitle,180,false,false) && st_text(v.welcomeText,180,false,false)
      : n==6 ? st_mobile(v) : n==7 ? st_desktop(v) : st_home(v); }
    function st_labNameValid(v) { let key=nameKey(v.name);
