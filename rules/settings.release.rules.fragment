    // Settings validation is prepared privately and immutably. Publishing the
    // setting, receipt and committed intent is still one atomic transaction.
    // This fragment depends only on the reviewed shared owner/schema helpers.
    function st_path(target,id) { return target=='lab' ? anyPath('labDefinitions',id) : singletonPath(id); }
    function st_preparedSettings(c) {
      return exact(c,['target','recordId','operationId','expectedRevision','createdAt','data'])
        && uuid(c.operationId) && expected(c.expectedRevision) && stamp(c.createdAt)
        && (c.target=='lab' ? uuid(c.recordId) && c.data is map && c.data.costs is list && c.data.costs.size()<=100
          : c.target=='clinicSettings' ? c.recordId=='clinicSettings' && c.data is map
            && c.data.medications is list && c.data.medications.size()<=300
            && c.data.whatsapp is map && c.data.whatsapp.templates is list && c.data.whatsapp.templates.size()<=60
          : c.target=='prostheticRouting' ? c.recordId=='prostheticRouting' && exact(c.data,['routes'])
            && c.data.routes is list && c.data.routes.size()<=100
