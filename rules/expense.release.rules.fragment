// Owner-only expenses and staged inventory. Included inside the database match.
// Private preparations are not purchases: only the final immutable receipt and
// committed journal make their candidate authoritative. No images in journals.
function ex_path(collection,id) { return /databases/$(database)/documents/clinics/main/$(collection)/$(id); }
function ex_proofPath(op,level,index) { return ex_path('expenseInventoryProofs',op+'-'+string(level)+'-'+string(index)); }
function ex_text(v,n,multi) { return v is string && v.size()<=n && (multi || v==trimSpaces(v))
  && (multi?v.matches('[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\p{Cf}\\p{Cs}\\p{Zl}\\p{Zp}]*')
    :v.matches('[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Zl}\\p{Zp}]*')); }
function ex_edit(d) { return d is map && d.keys().hasAll(['title','date','note','isFixed','recurringPeriod','expenseType'])
  && d.keys().hasOnly(['title','date','note','isFixed','recurringPeriod','expenseType','totalCents'])
  && ex_text(d.title,200,false) && d.title.size()>0 && day(d.date) && ex_text(d.note,4000,true)
  && d.isFixed is bool && d.recurringPeriod in ['monthly','yearly','none']
  && d.expenseType in ['rent','electricity','water','salary','supplies','maintenance','other']
  && (!('totalCents' in d) || money(d.totalCents)); }
function ex_header(d) { return exact(d,['title','category','expenseType','date','note','isFixed','recurringPeriod','supplierName',
  'supplierPhone','supplierAddress','invoiceNumber','invoiceDate','invoiceTime','taxNumber','commercialRecord','currency',
  'subtotalCents','taxCents','discountCents','totalCents','items'])
  && ex_edit({'title':d.title,'date':d.date,'note':d.note,'isFixed':d.isFixed,'recurringPeriod':d.recurringPeriod,'expenseType':d.expenseType})
  && d.category in ['supplies','fixed','maintenance','other'] && ex_text(d.supplierName,200,false)
  && ex_text(d.supplierPhone,40,false) && ex_text(d.supplierAddress,500,false) && ex_text(d.invoiceNumber,100,false)
  && (d.invoiceNumber=='' || d.supplierName!='') && day(d.invoiceDate)
  && d.invoiceTime is string && (d.invoiceTime=='' || d.invoiceTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]'))
  && ex_text(d.taxNumber,100,false) && ex_text(d.commercialRecord,100,false) && d.currency=='EGP'
  && money(d.subtotalCents) && money(d.taxCents) && money(d.discountCents) && money(d.totalCents)
  && d.discountCents<=d.subtotalCents && d.totalCents==d.subtotalCents+d.taxCents-d.discountCents
  && d.items is list && d.items.size()<=20 && (d.items.size()==0 || d.category=='supplies' && (d.subtotalCents>0 || d.totalCents==0)); }
function ex_imageMeta(m) { return exact(m,['sha256','byteLength','width','height','contentType']) && hash(m.sha256)
  && m.byteLength is int && m.byteLength>=16 && m.byteLength<=153600 && m.contentType=='image/jpeg'
  && m.width is int && m.height is int && m.width>=160 && m.width<=1600 && m.height>=160 && m.height<=1600
  && (m.width>=320 || m.height>=320) && m.width<=m.height*6 && m.height<=m.width*6; }
function ex_preparedExpense(c) { return c is map && uuid(c.operationId) && stamp(c.createdAt) && expected(c.expectedRevision)
  && (c.action=='create'?exact(c,['operationId','createdAt','action','recordId','expectedRevision','data','paidCents'])
      && uuid(c.recordId) && c.expectedRevision==0 && money(c.paidCents) && c.data is map
      && c.data.items is list && c.data.items.size()<=20 && money(c.data.totalCents) && c.paidCents<=c.data.totalCents
    :c.action=='edit'?exact(c,['operationId','createdAt','action','recordId','expectedRevision','data']) && uuid(c.recordId)
      && c.expectedRevision>0 && c.data is map
    :c.action=='pay'?exact(c,['operationId','createdAt','action','recordId','expectedRevision','amountCents','date','note'])
      && uuid(c.recordId) && c.expectedRevision>0 && money(c.amountCents) && c.amountCents>0 && day(c.date) && ex_text(c.note,2000,true)
    :c.action=='usage'?exact(c,['operationId','createdAt','action','materialId','expectedRevision','quantityMilli','kind','date','note'])
      && hash(c.materialId) && c.expectedRevision>0 && money(c.quantityMilli) && c.quantityMilli>0
      && c.kind in ['used','waste'] && day(c.date) && ex_text(c.note,2000,true)
    :c.action=='attach-image' && exact(c,['operationId','createdAt','action','recordId','expectedRevision','image'])
      && uuid(c.recordId) && c.expectedRevision>0 && ex_imageMeta(c.image)); }
function ex_materialId(name,unit) { return hashing.sha256('clinic-material-v2\x00'+name+'\x00'+unit).toHexString().lower(); }
function ex_invoiceKey(d) { return d.invoiceNumber==''?null:hashing.sha256('clinic-supplier-invoice-v2\x00'+d.supplierName+'\x00'+d.invoiceNumber).toHexString().lower(); }
// Five base-1e6 digits avoid overflowing int64 on accepted 1e12*1e12.
function ex_digit(v) { return v is int && v>=0 && v<1000000; }
function ex_carry(v) { return v is int && v>=0 && v<=2000000; }
function ex_carryVector(v) { return v is list && v.size()==4 && ex_carry(v[0]) && ex_carry(v[1]) && ex_carry(v[2]) && ex_carry(v[3]); }
// Explicit carries prevent repeated recursive expansion of arithmetic lets in
// the Rules interpreter. All coefficients stay below3e12, never int64 product.
function ex_operand(v,n) { return v is list && v.size()==3 && ex_digit(v[0]) && ex_digit(v[1]) && ex_digit(v[2])
  && n==v[0]+v[1]*1000000+v[2]*1000000000000; }
function ex_convolution(p,k,a,b,r) {
  return a[0]*b[0]+r[0]==p[0]+k[0]*1000000
    && a[0]*b[1]+a[1]*b[0]+r[1]+k[0]==p[1]+k[1]*1000000
    && a[0]*b[2]+a[1]*b[1]+a[2]*b[0]+r[2]+k[1]==p[2]+k[2]*1000000
    && a[1]*b[2]+a[2]*b[1]+k[2]==p[3]+k[3]*1000000 && a[2]*b[2]+k[3]==p[4]; }
function ex_ratioShape(p,a,b,d) { return exact(p,['quotient','remainder','right','denominator','product','productCarry','quotientCarry','operands']) && money(a) && money(b) && money(d) && d>0
  && money(p.quotient) && money(p.remainder) && p.remainder<d
  && p.product is list && p.product.size()==5 && p.productCarry is list && p.productCarry.size()==4
  && p.quotientCarry is list && p.quotientCarry.size()==4
  && p.right==b && p.denominator==d && exact(p.operands,['a','b','q','d','r']) && ex_operand(p.operands.a,a); }
function ex_ratioInputs(v) { return ex_operand(v.operands.b,v.right) && ex_operand(v.operands.d,v.denominator); }
function ex_ratioProduct(v) { return v.product is list && v.product.size()==5
  && ex_digit(v.product[0]) && ex_digit(v.product[1]) && ex_digit(v.product[2]) && ex_digit(v.product[3]) && ex_digit(v.product[4])
  && ex_carryVector(v.productCarry) && ex_convolution(v.product,v.productCarry,v.operands.a,v.operands.b,[0,0,0]); }
function ex_ratioQuotient(v) { return ex_operand(v.operands.q,v.quotient) && ex_operand(v.operands.r,v.remainder)
  && ex_carryVector(v.quotientCarry) && ex_convolution(v.product,v.quotientCarry,v.operands.q,v.operands.d,v.operands.r); }
function ex_mathPath(op,kind,index,part) { return ex_path('expenseInventoryProofs',op+'-math-'+kind+'-'+string(index)+'-'+string(part)); }
function ex_mathCreateShape(p,c) { let row=c.data.items[p.rowIndex];
  return p.kind=='item'?ex_ratioShape(p.ratio,row.quantityMilli,row.unitPriceCents,1000)
    :ex_ratioShape(p.ratio,row.totalCents,c.data.totalCents,c.data.subtotalCents==0?1:c.data.subtotalCents); }
function ex_mathUsageShape(p,c) { let s=get(ex_path('expenseInventoryProofs',p.operationId+'-usage')).data.source;
  return exact(p.basis,['costCents','quantityMilli']) && p.basis.costCents==s.costCents && p.basis.quantityMilli==s.quantityMilli
  && ex_ratioShape(p.ratio,p.basis.costCents,c.quantityMilli,p.basis.quantityMilli); }
function ex_mathFirst(p,id) { let i=get(intentPath(p.operationId)).data; let c=i.command;
  return exact(p,['schemaVersion','clinicId','operationId','actorUid','intentRequestHash','createdAt','kind','rowIndex','part','ratio','basis'])
    && p.schemaVersion is int && p.schemaVersion==2 && p.clinicId=='main' && uuid(p.operationId)
    && p.actorUid==request.auth.uid && i.actorUid==request.auth.uid && p.intentRequestHash==i.requestHash && p.createdAt==i.createdAt
    && i.kind=='expense' && i.status=='prepared' && !exists(ex_path('expenseOperations',p.operationId))
    && p.part is int && p.part==0 && p.rowIndex is int && p.rowIndex>=0
    && (p.kind=='usage'?c.action=='usage' && p.rowIndex==0:c.action=='create' && p.basis==null && p.kind in ['item','allocation'] && p.rowIndex<c.data.items.size())
    && id==p.operationId+'-math-'+p.kind+'-'+string(p.rowIndex)+'-'+string(p.part)
    && (p.kind=='usage'?ex_mathUsageShape(p,c):ex_mathCreateShape(p,c)); }
// The immutable preceding stage already binds the complete schema, row, ratio,
// actor and intent hash. A continuation may change ONLY part and drop its
// no-longer-needed basis; it never revalidates an expanded command expression.
function ex_mathNext(p,id) { let previous=get(ex_mathPath(p.operationId,p.kind,p.rowIndex,p.part-1)).data;
  let i=get(intentPath(p.operationId)).data;
  return p.part is int && p.part in [1,2,3] && previous.part==p.part-1
    && p.diff(previous).affectedKeys().hasOnly(['part','basis']) && p.basis==null
    && p.actorUid==request.auth.uid && i.actorUid==request.auth.uid && i.status=='prepared'
    && id==p.operationId+'-math-'+p.kind+'-'+string(p.rowIndex)+'-'+string(p.part)
    && (p.part==1?ex_ratioInputs(p.ratio):p.part==2?ex_ratioProduct(p.ratio):ex_ratioQuotient(p.ratio)); }
function ex_mathProof(p,id) { return p.part==0?ex_mathFirst(p,id):ex_mathNext(p,id); }
function ex_balance(b,id) { return exact(b,['schemaVersion','clinicId','recordId','revision','lastOperationId','name','unit',
  'purchasedMilli','purchaseCostCents','usedMilli','wasteMilli','consumedCostCents','identityVersion'])
  && b.schemaVersion is int && b.schemaVersion==1 && b.clinicId=='main' && b.recordId==id && b.identityVersion is int && b.identityVersion==2 && hash(id)
  && revision(b.revision) && uuid(b.lastOperationId) && ex_text(b.name,200,false) && b.name.size()>0
  && ex_text(b.unit,40,false) && b.unit.size()>0 && id==ex_materialId(b.name,b.unit)
  && money(b.purchasedMilli) && b.purchasedMilli>0 && money(b.purchaseCostCents) && money(b.usedMilli)
  && money(b.wasteMilli) && money(b.consumedCostCents) && b.usedMilli+b.wasteMilli<=b.purchasedMilli
  && b.consumedCostCents<=b.purchaseCostCents; }
function ex_headShape(h,id) { return exact(h,['schemaVersion','clinicId','recordId','base','pending'])
  && h.schemaVersion is int && h.schemaVersion==2 && h.clinicId=='main' && h.recordId==id && hash(id)
  && (h.base!=null || h.pending!=null); }
// Pending heads are frozen until their original journal is terminal. A later
// mutation resolves that terminal outcome, without rewriting historical cash.
function ex_resolved(h) { let i=h.pending==null?null:get(intentPath(h.pending.operationId)).data;
  return h.pending==null?h.base:i.status=='committed' && exists(ex_path('expenseOperations',h.pending.operationId))
    ?h.pending.candidate:i.status=='cancelled' && !exists(ex_path('expenseOperations',h.pending.operationId))?h.base:false; }
function ex_emptySummary() { return {'count':0,'indexes':[],'itemIds':[],'firstRank':0,'lastRank':-1,
  'firstRemainder':0,'lastRemainder':0,'firstItemId':'','lastItemId':'','firstBonus':false,'lastBonus':false,'subtotalCents':0,'costCents':0}; }
function ex_span(level) { return level==0?1:level==1?2:level==2?4:level==3?8:level==4?16:32; }
function ex_rootLevel(c) { return c.data.items.size()<=1?0:c.data.items.size()<=2?1:c.data.items.size()<=4?2:c.data.items.size()<=8?3:c.data.items.size()<=16?4:5; }
function ex_readSummary(c,level,index) { return index*ex_span(level)>=c.data.items.size()?ex_emptySummary()
  :get(ex_proofPath(c.operationId,level,index)).data.summary; }
function ex_order(a,b) { return b.count==0 || a.lastRank+1==b.firstRank && a.lastRemainder>=b.firstRemainder
  && (a.lastRemainder!=b.firstRemainder || a.lastItemId<b.firstItemId) && (a.lastBonus || !b.firstBonus); }
function ex_join(a,b,c,d) { let z=d.count>0?d:c.count>0?c:b.count>0?b:a;
  return {'count':a.count+b.count+c.count+d.count,'indexes':a.indexes.concat(b.indexes).concat(c.indexes).concat(d.indexes),
    'itemIds':a.itemIds.concat(b.itemIds).concat(c.itemIds).concat(d.itemIds),'firstRank':a.firstRank,'lastRank':z.lastRank,
    'firstRemainder':a.firstRemainder,'lastRemainder':z.lastRemainder,'firstItemId':a.firstItemId,'lastItemId':z.lastItemId,
    'firstBonus':a.firstBonus,'lastBonus':z.lastBonus,'subtotalCents':a.subtotalCents+b.subtotalCents+c.subtotalCents+d.subtotalCents,
    'costCents':a.costCents+b.costCents+c.costCents+d.costCents}; }
function ex_joinTwo(a,b) { let z=b.count>0?b:a;
  return {'count':a.count+b.count,'indexes':a.indexes.concat(b.indexes),'itemIds':a.itemIds.concat(b.itemIds),'firstRank':a.firstRank,'lastRank':z.lastRank,
    'firstRemainder':a.firstRemainder,'lastRemainder':z.lastRemainder,'firstItemId':a.firstItemId,'lastItemId':z.lastItemId,
    'firstBonus':a.firstBonus,'lastBonus':z.lastBonus,'subtotalCents':a.subtotalCents+b.subtotalCents,'costCents':a.costCents+b.costCents}; }
function ex_item(row,p) { return exact(row,['itemId','name','unit','quantityMilli','unitPriceCents','discountCents','taxCents','totalCents'])
  && uuid(row.itemId) && ex_text(row.name,200,false) && row.name.size()>0 && ex_text(row.unit,40,false) && row.unit.size()>0
  && money(row.quantityMilli) && row.quantityMilli>0 && money(row.unitPriceCents) && money(row.discountCents)
  && money(row.taxCents) && money(row.totalCents)
  && money(p.quotient+(p.remainder>=500?1:0))
  && row.discountCents<=p.quotient+(p.remainder>=500?1:0) && row.totalCents==p.quotient+(p.remainder>=500?1:0)-row.discountCents+row.taxCents; }
function ex_leaf(p,c) { let l=p.leaf; let row=c.data.items[l.rowIndex]; let s=p.summary;
  let item=get(ex_path('expenseInventoryProofs',c.operationId+'-item-'+string(l.rowIndex))).data;
  return exact(l,['rowIndex','rank','materialId','bonus','itemBase','allocation']) && l.rowIndex is int && l.rowIndex>=0 && l.rowIndex<c.data.items.size()
  && l.rank is int && l.rank==p.index && l.bonus is bool && item.operationId==c.operationId && item.itemBase==l.itemBase && l.materialId==ex_materialId(row.name,row.unit)
  && get(ex_mathPath(c.operationId,'allocation',l.rowIndex,3)).data.ratio==l.allocation
  && s=={'count':1,'indexes':[l.rowIndex],'itemIds':[row.itemId],'firstRank':p.index,'lastRank':p.index,
    'firstRemainder':l.allocation.remainder,'lastRemainder':l.allocation.remainder,'firstItemId':row.itemId,'lastItemId':row.itemId,
    'firstBonus':l.bonus,'lastBonus':l.bonus,'subtotalCents':row.totalCents,'costCents':l.allocation.quotient+(l.bonus?1:0)}
  && money(s.costCents); }
function ex_group(p,c) { let a=ex_readSummary(c,p.level-1,p.index*2); let b=ex_readSummary(c,p.level-1,p.index*2+1);
  return p.leaf==null && ex_order(a,b) && p.summary==ex_joinTwo(a,b); }
function ex_leafHead(p,c) { let l=p.leaf; let h=getAfter(ex_path('materialBalances',l.materialId)).data;
  return h.pending.operationId==c.operationId && h.pending.lastProofRank==p.index && l.rowIndex in h.pending.indexes
    && h.pending.candidate.lastOperationId==c.operationId; }
function ex_proofWrite(p,id) { let i=get(intentPath(p.operationId)).data; let c=i.command;
  return exact(p,['schemaVersion','clinicId','operationId','actorUid','requestHash','intentRequestHash','createdAt','level','index','summary','leaf'])
  && p.schemaVersion is int && p.schemaVersion==2 && p.clinicId=='main' && uuid(p.operationId) && p.actorUid==request.auth.uid && hash(p.requestHash)
  && p.intentRequestHash==i.requestHash && p.createdAt==i.createdAt && i.status=='prepared' && i.kind=='expense' && i.actorUid==request.auth.uid
  && c.action=='create' && p.level is int && p.level>=0 && p.level<=ex_rootLevel(c) && p.index is int && p.index>=0
  && p.index*ex_span(p.level)<c.data.items.size()
  && id==p.operationId+'-'+string(p.level)+'-'+string(p.index) && !exists(ex_path('expenseOperations',p.operationId))
  && (p.level==0?ex_leaf(p,c) && ex_leafHead(p,c):ex_group(p,c)); }
function ex_headerProof(p,id) { let i=get(intentPath(p.operationId)).data;
  return exact(p,['schemaVersion','clinicId','operationId','actorUid','intentRequestHash','createdAt','part'])
    && p.schemaVersion is int && p.schemaVersion==2 && p.clinicId=='main' && uuid(p.operationId)
    && p.part is int && p.part in [0,1] && id==p.operationId+'-header-'+string(p.part) && p.actorUid==request.auth.uid && i.actorUid==request.auth.uid
    && p.intentRequestHash==i.requestHash && p.createdAt==i.createdAt && i.status=='prepared' && i.kind=='expense'
    && i.command.action=='create' && !exists(ex_path('expenseOperations',p.operationId))
    && (p.part==0?ex_headerFinancial(i.command.data)
      :get(ex_path('expenseInventoryProofs',p.operationId+'-header-0')).data.operationId==p.operationId && ex_headerSupplier(i.command.data)); }
function ex_editProof(p,id) { let i=get(intentPath(p.operationId)).data;
  return exact(p,['schemaVersion','clinicId','operationId','actorUid','intentRequestHash','createdAt'])
    && p.schemaVersion is int && p.schemaVersion==2 && p.clinicId=='main' && uuid(p.operationId) && id==p.operationId+'-edit'
    && p.actorUid==request.auth.uid && i.actorUid==request.auth.uid && p.intentRequestHash==i.requestHash && p.createdAt==i.createdAt
    && i.status=='prepared' && i.kind=='expense' && i.command.action=='edit' && !exists(ex_path('expenseOperations',p.operationId))
    && ex_edit(i.command.data); }
function ex_usageBasis(p,id) { let i=get(intentPath(p.operationId)).data; let c=i.command; let s=p.source;
  return exact(p,['schemaVersion','clinicId','operationId','actorUid','intentRequestHash','createdAt','source'])
    && p.schemaVersion is int && p.schemaVersion==2 && p.clinicId=='main' && uuid(p.operationId) && id==p.operationId+'-usage'
    && p.actorUid==request.auth.uid && i.actorUid==request.auth.uid && p.intentRequestHash==i.requestHash && p.createdAt==i.createdAt
    && i.status=='prepared' && i.kind=='expense' && c.action=='usage' && !exists(ex_path('expenseOperations',p.operationId))
    && exact(s,['balance','costCents','quantityMilli']) && s.balance!=null && s.balance!=false
    && s.balance==ex_resolved(get(ex_path('materialBalances',c.materialId)).data)
    && s.balance.recordId==c.materialId && s.balance.revision==c.expectedRevision
    && s.quantityMilli==s.balance.purchasedMilli-s.balance.usedMilli-s.balance.wasteMilli
    && s.costCents==s.balance.purchaseCostCents-s.balance.consumedCostCents && c.quantityMilli<=s.quantityMilli; }
function ex_itemProof(p,id) { let i=get(intentPath(p.operationId)).data; let c=i.command;
  return exact(p,['schemaVersion','clinicId','operationId','actorUid','intentRequestHash','createdAt','rowIndex','itemBase'])
    && p.schemaVersion is int && p.schemaVersion==2 && p.clinicId=='main' && uuid(p.operationId)
    && p.rowIndex is int && p.rowIndex>=0 && p.rowIndex<c.data.items.size() && id==p.operationId+'-item-'+string(p.rowIndex)
    && p.actorUid==request.auth.uid && i.actorUid==request.auth.uid && p.intentRequestHash==i.requestHash && p.createdAt==i.createdAt
    && i.status=='prepared' && i.kind=='expense' && c.action=='create' && !exists(ex_path('expenseOperations',p.operationId))
    && get(ex_mathPath(c.operationId,'item',p.rowIndex,3)).data.ratio==p.itemBase && ex_item(c.data.items[p.rowIndex],p.itemBase); }
function ex_headerFinancial(d) { return exact(d,['title','category','expenseType','date','note','isFixed','recurringPeriod','supplierName',
  'supplierPhone','supplierAddress','invoiceNumber','invoiceDate','invoiceTime','taxNumber','commercialRecord','currency',
  'subtotalCents','taxCents','discountCents','totalCents','items'])
  && ex_edit({'title':d.title,'date':d.date,'note':d.note,'isFixed':d.isFixed,'recurringPeriod':d.recurringPeriod,'expenseType':d.expenseType})
  && d.category in ['supplies','fixed','maintenance','other'] && money(d.subtotalCents) && money(d.taxCents) && money(d.discountCents) && money(d.totalCents)
  && d.discountCents<=d.subtotalCents && d.totalCents==d.subtotalCents+d.taxCents-d.discountCents
  && d.items is list && d.items.size()<=20 && (d.items.size()==0 || d.category=='supplies' && (d.subtotalCents>0 || d.totalCents==0)); }
function ex_headerSupplier(d) { return ex_text(d.supplierName,200,false) && ex_text(d.supplierPhone,40,false) && ex_text(d.supplierAddress,500,false)
  && ex_text(d.invoiceNumber,100,false) && (d.invoiceNumber=='' || d.supplierName!='') && day(d.invoiceDate)
  && d.invoiceTime is string && (d.invoiceTime=='' || d.invoiceTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]'))
  && ex_text(d.taxNumber,100,false) && ex_text(d.commercialRecord,100,false) && d.currency=='EGP'; }
function ex_roots(c) { let level=ex_rootLevel(c); let a=ex_readSummary(c,level,0); let b=ex_readSummary(c,level,1);
  let d=ex_readSummary(c,level,2); let e=ex_readSummary(c,level,3); let s=ex_join(a,b,d,e);
  return c.data.items.size()==0 || ex_order(a,b) && (d.count==0 || ex_order(b,d)) && (e.count==0 || ex_order(d,e))
    && s.count==c.data.items.size() && s.indexes.size()==s.count && s.indexes.toSet().size()==s.count
    && s.itemIds.toSet().size()==s.count && s.firstRank==0 && s.lastRank==s.count-1
    && s.subtotalCents==c.data.subtotalCents && s.costCents==c.data.totalCents; }
function ex_completeProof(p,id) { let i=get(intentPath(p.operationId)).data; let c=i.command; let s=p.summary;
  return exact(p,['schemaVersion','clinicId','operationId','actorUid','intentRequestHash','createdAt','summary'])
    && p.schemaVersion is int && p.schemaVersion==2 && p.clinicId=='main' && uuid(p.operationId) && id==p.operationId+'-complete'
    && p.actorUid==request.auth.uid && i.actorUid==request.auth.uid && p.intentRequestHash==i.requestHash && p.createdAt==i.createdAt
    && i.status=='prepared' && i.kind=='expense' && c.action=='create' && c.data.items.size()>0 && !exists(ex_path('expenseOperations',p.operationId))
    && s==get(ex_proofPath(p.operationId,ex_rootLevel(c),0)).data.summary
    && s.count==c.data.items.size() && s.indexes.size()==s.count && s.indexes.toSet().size()==s.count && s.itemIds.toSet().size()==s.count
    && s.firstRank==0 && s.lastRank==s.count-1 && s.subtotalCents==c.data.subtotalCents && s.costCents==c.data.totalCents; }
function ex_pendingHead(before,h,id) { let p=h.pending; let i=get(intentPath(p.operationId)).data; let c=i.command;
  let n=p.indexes[p.indexes.size()-1]; let old=before==null?null:before.data;
  let same=old!=null && old.pending!=null && old.pending.operationId==p.operationId;
  let base=old==null?null:same?old.base:ex_resolved(old); let prior=same?old.pending.candidate:base;
  let row=c.data.items[n];
  return exact(p,['operationId','indexes','lastProofRank','candidate']) && i.kind=='expense' && i.status=='prepared' && i.actorUid==request.auth.uid && c.action=='create'
    && base!=false && h.base==base && ex_balance(p.candidate,id) && p.candidate.lastOperationId==p.operationId
    && p.indexes is list && p.indexes.size()>0 && p.indexes.size()<=20 && p.indexes.toSet().size()==p.indexes.size()
    && n is int && n>=0 && n<c.data.items.size() && p.indexes==(same?old.pending.indexes:[]).concat([n])
    && p.candidate.revision==(base==null?0:base.revision)+1 && p.candidate.name==row.name && p.candidate.unit==row.unit
    && p.candidate.purchasedMilli==(prior==null?0:prior.purchasedMilli)+row.quantityMilli
    && p.candidate.usedMilli==(base==null?0:base.usedMilli) && p.candidate.wasteMilli==(base==null?0:base.wasteMilli)
    && p.candidate.consumedCostCents==(base==null?0:base.consumedCostCents)
    // One new leaf with this row/rank is required. Its independently validated
    // ratio and allocated cents determine the stock increment, not the caller.
    && ex_headLeafCoupling(old,h,c,n,same,prior); }
function ex_headLeafCoupling(old,h,c,n,same,prior) {
  let rank=h.pending.lastProofRank; let p=getAfter(ex_proofPath(c.operationId,0,rank)).data;
  return rank is int && rank>=0 && rank<c.data.items.size() && (!same || rank>old.pending.lastProofRank)
    && !exists(ex_proofPath(c.operationId,0,rank)) && p.leaf.rowIndex==n && p.leaf.materialId==h.recordId
    && h.pending.candidate.purchaseCostCents==(prior==null?0:prior.purchaseCostCents)+p.summary.costCents;
}
function ex_usageHead(before,h,id) { let b=h.base; let base=get(ex_path('expenseInventoryProofs',b.lastOperationId+'-usage')).data.source.balance;
  let op=getAfter(ex_path('expenseOperations',b.lastOperationId)).data;
  let c=get(intentPath(b.lastOperationId)).data.command; let available=base.purchasedMilli-base.usedMilli-base.wasteMilli;
  let cost=base.purchaseCostCents-base.consumedCostCents; let ratio=op.usageMath;
  let charged=c.quantityMilli==available?cost:ratio.quotient+(ratio.remainder*2>=available?1:0);
  return base==ex_resolved(before.data) && h.pending==null && ex_balance(b,id) && c.action=='usage' && c.materialId==id
    && c.expectedRevision==base.revision && b.revision==base.revision+1 && c.quantityMilli<=available
    && b.diff(base).affectedKeys().hasOnly(['revision','lastOperationId','usedMilli','wasteMilli','consumedCostCents'])
    && b.usedMilli==base.usedMilli+(c.kind=='used'?c.quantityMilli:0) && b.wasteMilli==base.wasteMilli+(c.kind=='waste'?c.quantityMilli:0)
    && get(ex_mathPath(c.operationId,'usage',0,3)).data.ratio==ratio && b.consumedCostCents==base.consumedCostCents+charged
    && getAfter(ex_path('materialUsages',b.lastOperationId)).data.costCents==charged
    && !exists(ex_path('expenseOperations',b.lastOperationId)) && op.recordId==id && op.action=='usage'; }
function ex_recordShape(d,id) { return exact(d,['schemaVersion','clinicId','recordId','revision','lastOperationId','data','paidCents','paymentCount','invoiceKey','imageId','image','inventoryVersion'])
  && d.schemaVersion is int && d.schemaVersion==1 && d.clinicId=='main' && d.recordId==id && uuid(id) && revision(d.revision) && uuid(d.lastOperationId)
  && d.inventoryVersion is int && d.inventoryVersion==2 && money(d.paidCents) && d.paymentCount is int && d.paymentCount>=0 && d.paymentCount<=d.revision
  && d.paidCents<=d.data.totalCents && ((d.paidCents==0)==(d.paymentCount==0))
  && (d.imageId==null?d.image==null:uuid(d.imageId) && ex_imageMeta(d.image)); }
function ex_expenseWrite(before,d,id) { let c=get(intentPath(d.lastOperationId)).data.command;
  let r=getAfter(ex_path('expenseOperations',d.lastOperationId)).data; let b=before==null?null:before.data;
  return ex_recordShape(d,id) && c.recordId==id && r.recordId==id && !exists(ex_path('expenseOperations',d.lastOperationId))
    && d.revision==c.expectedRevision+1 && (b==null?c.expectedRevision==0:c.expectedRevision==b.revision)
    && (c.action=='create'?b==null && get(ex_path('expenseInventoryProofs',c.operationId+'-header-1')).data.operationId==c.operationId
      && d.data==c.data && (c.data.items.size()==0 || get(ex_path('expenseInventoryProofs',c.operationId+'-complete')).data.operationId==c.operationId)
      && d.paidCents==c.paidCents && d.paymentCount==(c.paidCents>0?1:0) && d.imageId==null && d.invoiceKey==ex_invoiceKey(c.data)
      && (d.invoiceKey==null || getAfter(ex_path('supplierInvoiceReservations',d.invoiceKey)).data.expenseId==id)
    :b!=null && d.diff(b).affectedKeys().hasOnly(c.action=='edit'?['revision','lastOperationId','data']
      :c.action=='pay'?['revision','lastOperationId','paidCents','paymentCount']:['revision','lastOperationId','imageId','image'])
      && (c.action=='edit'?get(ex_path('expenseInventoryProofs',c.operationId+'-edit')).data.operationId==c.operationId
        && ex_editedData(b.data,d.data,c.data) && d.paidCents<=d.data.totalCents
        :c.action=='pay'?d.paidCents==b.paidCents+c.amountCents && d.paymentCount==b.paymentCount+1
        :c.action=='attach-image' && d.imageId==c.operationId && d.image==c.image && existsAfter(ex_path('invoiceImages',c.operationId))))
    && ex_paymentCoupled(c,d); }
function ex_editedData(b,a,c) { return a.diff(b).affectedKeys().hasOnly(['title','date','note','isFixed','recurringPeriod','expenseType','totalCents','subtotalCents'])
  && a.title==c.title && a.date==c.date && a.note==c.note && a.isFixed==c.isFixed && a.recurringPeriod==c.recurringPeriod && a.expenseType==c.expenseType
  && ('totalCents' in c?b.items.size()==0 && a.totalCents==c.totalCents && money(a.subtotalCents)
    && a.subtotalCents==c.totalCents-b.taxCents+b.discountCents && a.discountCents<=a.subtotalCents
    :a.totalCents==b.totalCents && a.subtotalCents==b.subtotalCents); }
function ex_paymentCoupled(c,d) { let amount=c.action=='create'?c.paidCents:c.action=='pay'?c.amountCents:0;
  return amount==0?!existsAfter(ex_path('expensePayments',c.operationId))
    :getAfter(ex_path('expensePayments',c.operationId)).data.expenseId==d.recordId; }
function ex_receipt(r,id) { let i=get(intentPath(id)).data; let c=i.command;
  return exact(r,['schemaVersion','clinicId','operationId','recordId','actorUid','action','expectedRevision','resultRevision','createdAt','requestHash','inventoryVersion','usageMath'])
    && r.schemaVersion is int && r.schemaVersion==1 && r.clinicId=='main' && r.operationId==id && uuid(id) && r.actorUid==request.auth.uid
    && hash(r.requestHash) && r.inventoryVersion is int && r.inventoryVersion==2 && r.createdAt==i.createdAt && r.action==c.action
    && r.recordId==(c.action=='usage'?c.materialId:c.recordId) && expected(r.expectedRevision) && r.expectedRevision==c.expectedRevision && revision(r.resultRevision) && r.resultRevision==c.expectedRevision+1
    && (c.action=='usage'?r.usageMath!=null:r.usageMath==null) && coupledIntent('expense',id)
    && (c.action=='usage'?getAfter(ex_path('materialBalances',c.materialId)).data.base.lastOperationId==id
      && !exists(ex_path('materialUsages',id)) && existsAfter(ex_path('materialUsages',id))
      :getAfter(ex_path('expenseRecords',c.recordId)).data.lastOperationId==id); }
function ex_payment(p,id) { let c=get(intentPath(id)).data.command;
  return exact(p,['schemaVersion','clinicId','recordId','expenseId','amountCents','date','note','actorUid','createdAt'])
    && p.schemaVersion is int && p.schemaVersion==1 && p.clinicId=='main' && p.recordId==id && uuid(id) && p.expenseId==c.recordId && p.actorUid==request.auth.uid
    && p.createdAt==c.createdAt && c.action in ['create','pay'] && money(p.amountCents) && p.amountCents==(c.action=='create'?c.paidCents:c.amountCents) && p.amountCents>0
    && p.date==(c.action=='create'?c.data.date:c.date) && p.note==(c.action=='create'?'':c.note)
    && !exists(ex_path('expenseOperations',id)) && getAfter(ex_path('expenseOperations',id)).data.recordId==p.expenseId
    && getAfter(ex_path('expenseRecords',p.expenseId)).data.lastOperationId==id; }
function ex_usage(u,id) { let c=get(intentPath(id)).data.command; let h=getAfter(ex_path('materialBalances',c.materialId)).data;
  return exact(u,['schemaVersion','clinicId','recordId','materialId','name','unit','quantityMilli','costCents','kind','date','note','actorUid','createdAt'])
    && u.schemaVersion is int && u.schemaVersion==1 && u.clinicId=='main' && u.recordId==id && uuid(id) && c.action=='usage' && u.materialId==c.materialId
    && u.name==h.base.name && u.unit==h.base.unit && money(u.quantityMilli) && u.quantityMilli==c.quantityMilli && u.kind==c.kind && u.date==c.date && u.note==c.note
    && u.actorUid==request.auth.uid && u.createdAt==c.createdAt && money(u.costCents) && h.base.lastOperationId==id
    && !exists(ex_path('expenseOperations',id)) && getAfter(ex_path('expenseOperations',id)).data.recordId==u.materialId; }
function ex_image(im,id) { let c=get(intentPath(id)).data.command; let e=getAfter(ex_path('expenseRecords',c.recordId)).data;
  return exact(im,['schemaVersion','clinicId','recordId','expenseId','actorUid','createdAt','sha256','byteLength','width','height','contentType','bytes'])
    && im.schemaVersion is int && im.schemaVersion==1 && im.clinicId=='main' && im.recordId==id && uuid(id) && c.action=='attach-image' && im.expenseId==c.recordId
    && im.actorUid==request.auth.uid && im.createdAt==c.createdAt && im.sha256==c.image.sha256 && im.byteLength==c.image.byteLength
    && im.width is int && im.height is int && im.byteLength is int && im.width==c.image.width && im.height==c.image.height && im.contentType=='image/jpeg' && ex_imageMeta(c.image)
    && im.bytes is bytes && im.bytes.size()==im.byteLength && im.bytes.size()<=153600
    && hashing.sha256(im.bytes).toHexString().lower()==im.sha256
    && e.imageId==id && e.image==c.image && e.lastOperationId==id && !exists(ex_path('expenseOperations',id))
    && getAfter(ex_path('expenseOperations',id)).data.recordId==c.recordId; }
function ex_reservation(d,id) { let c=get(intentPath(d.operationId)).data.command;
  return exact(d,['schemaVersion','clinicId','recordId','expenseId','operationId']) && d.schemaVersion is int && d.schemaVersion==1 && d.clinicId=='main'
    && d.recordId==id && hash(id) && c.action=='create' && d.expenseId==c.recordId && id==ex_invoiceKey(c.data)
    && !exists(ex_path('expenseOperations',d.operationId)) && getAfter(ex_path('expenseOperations',d.operationId)).data.recordId==d.expenseId
    && getAfter(ex_path('expenseRecords',d.expenseId)).data.invoiceKey==id && getAfter(ex_path('expenseRecords',d.expenseId)).data.lastOperationId==d.operationId; }
match /clinics/main/expenseRecords/{id} { allow get: if owner() && uuid(id); allow list: if owner() && boundedQuery();
  // Every mutation requires a NEW companion receipt. Its mandatory rule is
  // the canonical owner/intent gate; repeating it exceeds request budgets.
  allow create,update: if ex_expenseWrite(resource,request.resource.data,id); allow delete: if false; }
match /clinics/main/expenseOperations/{id} { allow get: if owner() && uuid(id); allow create: if owner() && ex_receipt(request.resource.data,id); allow list,update,delete: if false; }
match /clinics/main/expensePayments/{id} { allow get: if owner() && uuid(id); allow list: if owner() && boundedQuery();
  allow create: if ex_payment(request.resource.data,id); allow update,delete: if false; }
match /clinics/main/materialUsages/{id} { allow get: if owner() && uuid(id); allow list: if owner() && boundedQuery();
  allow create: if ex_usage(request.resource.data,id); allow update,delete: if false; }
match /clinics/main/materialBalances/{id} { allow get: if owner() && hash(id); allow list: if owner() && boundedQuery();
  // Purchase heads require a new owner-checked leaf; usage requires a new
  // owner-checked receipt. Existing proofs/receipts can never mutate a head.
  allow create,update: if ex_headShape(request.resource.data,id)
    && (request.resource.data.pending!=null?ex_pendingHead(resource,request.resource.data,id):resource!=null && ex_usageHead(resource,request.resource.data,id)); allow delete: if false; }
match /clinics/main/expenseInventoryProofs/{id} { allow get: if owner() && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}-(usage|edit|complete|header-[01]|math-(item|allocation|usage)-([0-9]|1[0-9])-[0-3]|item-([0-9]|1[0-9])|[0-5]-([0-9]|1[0-9]))');
  allow create: if owner() && (id.matches('.*-usage')?ex_usageBasis(request.resource.data,id):id.matches('.*-edit')?ex_editProof(request.resource.data,id):id.matches('.*-complete')?ex_completeProof(request.resource.data,id):id.matches('.*-math-(item|allocation|usage)-([0-9]|1[0-9])-[0-3]')?ex_mathProof(request.resource.data,id):id.matches('.*-header-[01]')?ex_headerProof(request.resource.data,id)
    :id.matches('.*-item-([0-9]|1[0-9])')?ex_itemProof(request.resource.data,id):ex_proofWrite(request.resource.data,id)); allow list,update,delete: if false; }
match /clinics/main/supplierInvoiceReservations/{id} { allow get: if owner() && hash(id); allow create: if ex_reservation(request.resource.data,id); allow list,update,delete: if false; }
match /clinics/main/invoiceImages/{id} { allow get: if owner() && uuid(id); allow create: if ex_image(request.resource.data,id); allow list,update,delete: if false; }
